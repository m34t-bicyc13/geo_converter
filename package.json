{
  "name": "geo-converter",
  "version": "0.1.0",
  "description": "Просмотр geosite.dat и конвертация категорий в upstream-правила AdGuard Home",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
